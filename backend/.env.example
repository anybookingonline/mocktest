# --- Database (Supabase Postgres) ---
# IMPORTANT: use the IPv4 transaction pooler host, NOT db.<ref>.supabase.co
# (that hostname resolves only to IPv6, which this sandbox cannot reach).
# Format: postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
PGSSL=false
PGPOOL_MAX=10

# --- Upstash Redis cache (optional) ---
# Without UPSTASH_REDIS_REST_TOKEN the app falls back to an in-process TTL cache.
UPSTASH_REDIS_REST_URL=https://<upstash-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001
